# RECON-X local configuration. Copy to .env and replace placeholders as needed.
# Never commit .env or put private values in frontend files.
HOST=127.0.0.1
PORT=8000
RECONX_DATA_DIR=./app/db
RECONX_SEED_DEMO_DATA=false
RECONX_AUTH_ENABLED=false
RECONX_AUTH_USERNAME=
RECONX_AUTH_PASSWORD=
RECONX_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional protected PostgreSQL connection. Use either DATABASE_URL or PG* fields.
# The connection role must be reconx_demo_reader. Supabase connections require TLS.
DATABASE_URL=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=reconx_demo
PGUSER=reconx_demo_reader
PGPASSWORD=
PGSSLMODE=prefer

# Browser-safe Supabase settings only (publishable key; never put service-role keys here).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
