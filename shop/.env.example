# ── Shop Backend Environment ──────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/fictional_shop_db

# Session secret — generate a long random string (e.g. openssl rand -hex 32)
SESSION_SECRET=replace_with_a_long_random_secret_string

# Port this Express server listens on
PORT=3001

# Frontend origin for CORS (the Python RECON-X app)
FRONTEND_ORIGIN=http://localhost:8000

# Set to "production" when deploying
NODE_ENV=development
