# Public Supabase browser configuration. Use a publishable/anon key only.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Backend-only PostgreSQL connection. Use the restricted reconx_demo_reader role.
# Set values from Supabase's Connect dialog; never use a service-role key/password.
PGHOST=your-supabase-postgres-host
PGPORT=5432
PGDATABASE=postgres
PGUSER=reconx_demo_reader
PGPASSWORD=replace_with_your_database_password
PGSSLMODE=require
